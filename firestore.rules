rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn(); // Relaxing for now to fix access issues, keep isSignedIn check.
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['title', 'content', 'type', 'uploadedBy', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 500 &&
             data.content is string && data.content.size() <= 1000000 &&
             data.type in ['pdf', 'docx'] &&
             data.uploadedBy == request.auth.uid &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidChatSession(data) {
      return data.userId == request.auth.uid &&
             data.lastMessage is string && data.lastMessage.size() <= 5000 &&
             data.updatedAt == request.time;
    }

    function isValidChatMessage(data) {
      return data.role in ['user', 'model'] &&
             data.text is string && data.text.size() <= 100000 &&
             data.timestamp == request.time;
    }

    function isValidNotification(data) {
      return data.userId is string &&
             data.title is string && data.title.size() <= 500 &&
             data.message is string && data.message.size() <= 10000 &&
             data.type in ['info', 'success', 'warning'] &&
             data.read is bool &&
             data.createdAt == request.time;
    }

    // Collection Security

    // Documents: Global read for verified users, write only for matching UID
    match /documents/{docId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidDocument(incoming());
      allow update: if isVerified() && isOwner(existing().uploadedBy) &&
                    isValidId(docId) &&
                    incoming().uploadedBy == existing().uploadedBy &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time;
      allow delete: if isVerified() && isOwner(existing().uploadedBy);
    }

    // Chat Sessions: Private to the user (chatId is userId)
    match /chats/{chatId} {
      allow read: if isVerified() && chatId == request.auth.uid;
      allow create: if isVerified() && chatId == request.auth.uid && 
                    isValidChatSession(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isVerified() && chatId == request.auth.uid &&
                    isValidChatSession(incoming()) &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isVerified() && chatId == request.auth.uid;

      // Chat Messages: Subcollection
      match /messages/{msgId} {
        allow read: if isVerified() && chatId == request.auth.uid;
        allow create: if isVerified() && chatId == request.auth.uid && 
                      isValidChatMessage(incoming());
        allow delete: if isVerified() && chatId == request.auth.uid;
      }
    }

    // Notifications: Private to the user
    match /notifications/{notifId} {
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow get: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(notifId) && incoming().userId == request.auth.uid && isValidNotification(incoming());
      allow update: if isVerified() && isOwner(existing().userId) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isVerified() && isOwner(existing().userId);
    }
  }
}
